# === CONFIGURATION FILE FOR POWER_MANAGER.SH ===

# A space-separated list of IP addresses for the sentinel hosts.
# These should be reliable devices on grid power (not on the UPS).
# Example: Smart plugs, IoT devices, a printer, etc.
SENTINEL_HOSTS="192.168.1.11 192.168.1.12 192.168.1.13 192.168.1.14"

# The time in minutes to wait after power is restored before sending WoL packets.
# This prevents waking servers during unstable power conditions (flickering).
WOL_DELAY_MINUTES=5

# The time in minutes after which a client is considered stale if it hasn't
# reported its status.
CLIENT_STALE_TIMEOUT_MINUTES="5"

# The path to the dummy-ups driver's state file
UPS_STATE_FILE="/var/run/nut/virtual.device"

# Default broadcast address for WoL packets if not specified per host
DEFAULT_BROADCAST_IP="192.168.1.255"

# The secret token for API authentication.
# This MUST match the API_TOKEN used by UPS_monitor clients.
API_TOKEN="your_super_secret_api_token"

# Enable Power Outage Simulation mode.
# When set to "true", this will force the UPS status to "OB LB" regardless
# of the sentinel hosts' status. Useful for testing shutdown procedures.
# Valid values: "true" or "false".
POWER_SIMULATION_MODE="false"

# === VICTRON BATTERY MONITOR (VBM) INTEGRATION ===
#
# Optional. When enabled, the server reads live battery data (voltage, current,
# state of charge, estimated runtime) from a victron-bm-webui instance:
# https://github.com/MarekWo/victron-bm-webui
#
# This gives two things the sentinel hosts cannot:
#   1. A direct answer to "is mains actually gone?" - a network outage that
#      takes all sentinels offline no longer looks like a power failure.
#   2. Real remaining capacity, so each host can be shut down at its own
#      state-of-charge threshold instead of on a fixed timer.
#
# The integration is always optional and never load-bearing: if the service is
# down, unreachable or serving stale readings, the server silently falls back
# to sentinel-based detection.

# Master switch for the whole integration.
BATTERY_ENABLED="false"

# Base URL of the victron-bm-webui instance. With network_mode: host both
# containers share the host network, so localhost works.
BATTERY_API_URL="http://localhost:8088"

# HTTP timeout in seconds for each request to the battery monitor.
BATTERY_API_TIMEOUT="5"

# Readings older than this (seconds) are rejected as stale, triggering the
# fallback to sentinel logic. The BLE device is normally read every 10s.
BATTERY_MAX_DATA_AGE="60"

# Fallback mains detection, used ONLY when the victron-bm-webui instance is too
# old to report `ac_power` itself. Newer versions do this properly (with
# hysteresis and debounce) and these values are then ignored.
BATTERY_AC_FALLBACK_VOLTAGE="13.50"
BATTERY_AC_DISCHARGE_CURRENT="-1.0"
# At/above this charging current mains is considered back, without waiting for
# voltage to climb - which it does very slowly out of a deep discharge. Set to
# 0 if an independent DC source (solar/MPPT) can also charge the bank.
BATTERY_AC_CHARGE_CURRENT="2.0"

# --- Decision mode ---
# "observe" - the battery rules run, are logged and shown in the Web GUI, but
#             clients keep being told exactly what the sentinel hosts imply.
#             Nothing shuts down differently. Start here, watch the log for
#             "SOURCE DISAGREEMENT" lines for a few days, and confirm the
#             battery monitor agrees with reality before handing over control.
# "enforce" - the battery rules actually decide when each host shuts down.
BATTERY_DECISION_MODE="observe"

# Default power source for hosts that do not set POWER_SOURCE themselves.
# One of: sentinel | battery | both
BATTERY_DEFAULT_POWER_SOURCE="sentinel"

# --- Default battery thresholds ---
# Applied to any host that does not override them. All are optional; the
# built-in values below are used if a key is absent entirely.
#
# The voltage figures are backstops, not the primary rule - keep them low
# enough that SHUTDOWN_SOC is what actually fires. Battery voltage collapses
# hard under load: a ~100Ah bank measured 13.78V at rest and 12.23V the instant
# a 56A load moved onto it, still at 99% SoC. Set too high, the voltage rule
# trips around half charge and trips for every host at once, which throws away
# the per-host thresholds. Measure your own bank under its real load.
BATTERY_DEFAULT_CRITICAL_VOLTAGE="11.0"     # V - shut down immediately
BATTERY_DEFAULT_SHUTDOWN_VOLTAGE="11.4"     # V - shut down
BATTERY_DEFAULT_SHUTDOWN_SOC="25"           # % - shut down
BATTERY_DEFAULT_MIN_RUNTIME_MINUTES="0"     # min - 0 disables this rule
BATTERY_DEFAULT_WOL_MIN_SOC="0"             # % - 0 disables the WoL gate

# Safety net for the WoL charge gate: after this many minutes of waiting for
# the battery to recover, hosts are woken regardless, so a stuck or failed
# battery monitor cannot keep them asleep forever. 0 disables the limit.
WOL_MAX_WAIT_MINUTES="240"

# --- Battery simulation (for testing) ---
# Overlays fixed values on top of the real reading, so shutdown thresholds can
# be exercised without actually draining the battery. Leave a value empty to
# keep the real one. Works independently of POWER_SIMULATION_MODE.
BATTERY_SIMULATION="false"
BATTERY_SIM_AC_POWER=""       # true | false
BATTERY_SIM_SOC=""            # percent, e.g. 25
BATTERY_SIM_VOLTAGE=""        # volts, e.g. 11.9
BATTERY_SIM_CURRENT=""        # amps, e.g. -30
BATTERY_SIM_REMAINING=""      # minutes, e.g. 20

# === SMTP NOTIFICATIONS ===
# SMTP_SERVER="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USE_TLS="auto"
# SMTP_USER="user@example.com"
# SMTP_PASSWORD="your_password"
# SMTP_SENDER_NAME="UPS Server"
# SMTP_SENDER_EMAIL="ups@example.com"
# SMTP_RECIPIENTS="admin@example.com,support@example.com"

# SMTP_USE_TLS Options:
# - "auto" (default): Use STARTTLS on all ports except 26 (legacy behavior)
# - "true": Always attempt to use STARTTLS (except on port 465 which uses SSL)
# - "false": Never use STARTTLS (for servers that don't support it)

# === NOTIFICATION SETTINGS ===
# Enable or disable notifications for specific events. Valid values: "true" or "false".
# NOTIFY_POWER_FAIL="true"
# NOTIFY_POWER_RESTORED="true"
# NOTIFY_CLIENT_SHUTDOWN="true"
# NOTIFY_CLIENT_STALE="true"
# NOTIFY_APP_ERROR="true"
# NOTIFY_SIMULATION_MODE="true"

# === WAKE-ON-LAN HOST DEFINITIONS ===
# Define each host that should be awakened after power restoration
# Each host should have its own section with the following parameters:
# NAME - A descriptive name for the host (for logging purposes)
# IP - The IP address of the host
# MAC - The MAC address of the host (use colons as separators)
# BROADCAST_IP - (Optional) Specific broadcast IP for this host
# SHUTDOWN_DELAY_MINUTES - (Optional) Makes host a UPS client. Use 0 for immediate shutdown.
#
# Battery monitor settings (all optional, only used when BATTERY_ENABLED=true):
# POWER_SOURCE - Which source decides this host's power state:
#                  sentinel (default) - ping-based detection only, as before
#                  battery  - the Victron monitor decides; falls back to
#                             sentinel automatically if its data is unavailable
#                  both     - only declare an outage when BOTH agree; the most
#                             conservative option, immune to network faults
# CRITICAL_VOLTAGE / SHUTDOWN_VOLTAGE / SHUTDOWN_SOC / MIN_RUNTIME_MINUTES
#              - Per-host shutdown thresholds; fall back to the BATTERY_DEFAULT_*
#                values above when omitted.
# WOL_MIN_SOC  - Do not send Wake-on-LAN until the battery reaches this charge.
#
# Note: with POWER_SOURCE=battery the thresholds already decide *when* to shut
# down, so SHUTDOWN_DELAY_MINUTES becomes an extra grace period on top. Values
# of 0-2 are usually what you want for battery-driven hosts.

[WAKE_HOST_1]
NAME=Synology NAS
IP=192.168.2.12
MAC=00:11:32:f8:af:9f
BROADCAST_IP=192.168.2.255
SHUTDOWN_DELAY_MINUTES=10

[WAKE_HOST_2]
NAME=Proxmox Virtual Environment
IP=192.168.1.13
MAC=00:11:32:2c:31:42
SHUTDOWN_DELAY_MINUTES=5

[WAKE_HOST_3]
NAME=File Server
IP=192.168.1.15
MAC=00:11:32:aa:bb:cc
BROADCAST_IP=192.168.1.255
SHUTDOWN_DELAY_MINUTES=15

# UPS Client with immediate shutdown (for short battery life UPS)
[WAKE_HOST_4]
NAME=Low-Battery Host
IP=192.168.1.16
MAC=00:11:32:dd:ee:ff
SHUTDOWN_DELAY_MINUTES=0

# Battery-driven host: shut down at 40% charge, wake again at 90%.
# Less critical, so it gives up its share of the battery early.
[WAKE_HOST_5]
NAME=Media Server
IP=192.168.1.17
MAC=00:11:32:11:22:33
SHUTDOWN_DELAY_MINUTES=2
POWER_SOURCE=battery
SHUTDOWN_SOC=40
WOL_MIN_SOC=90

# Critical host: runs the battery down much further, and requires both the
# battery monitor and the sentinel hosts to agree before shutting down.
[WAKE_HOST_6]
NAME=Critical Server
IP=192.168.1.18
MAC=00:11:32:44:55:66
SHUTDOWN_DELAY_MINUTES=0
POWER_SOURCE=both
SHUTDOWN_SOC=15
CRITICAL_VOLTAGE=11.0
MIN_RUNTIME_MINUTES=10
WOL_MIN_SOC=95

# === POWER OUTAGE SIMULATION SCHEDULES ===
#
# Each schedule must have its own section [SCHEDULE_X]
#
# Parameters:
# NAME - A descriptive name for the schedule.
# TYPE - "one-time" or "recurring".
# DATE - (for one-time) The date in YYYY-MM-DD format.
# DAY_OF_WEEK - (for recurring) The day: "monday", "tuesday", ..., "sunday", or "everyday".
# TIME - The time in HH:MM format (24-hour).
# ACTION - "start" or "stop" the simulation.
# ENABLED - "true" or "false". One-time schedules are automatically disabled after running.

# [SCHEDULE_1]
# NAME="Weekly Test Shutdown"
# TYPE="recurring"
# DAY_OF_WEEK="friday"
# TIME="23:00"
# ACTION="start"
# ENABLED="true"

# [SCHEDULE_2]
# NAME="Weekly Test Power On"
# TYPE="recurring"
# DAY_OF_WEEK="saturday"
# TIME="01:00"
# ACTION="stop"
# ENABLED="true"

# [SCHEDULE_3]
# NAME="One-time Maintenance"
# TYPE="one-time"
# DATE="2025-12-24"
# TIME="22:00"
# ACTION="start"
# ENABLED="true"